{
  "name": "versuscloud-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "VERSUSCLOUD — десктопный клиент (Electron)",
  "author": "versus3927",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/versus3927/soundcloud.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.versus3927.versuscloud",
    "productName": "VERSUSCLOUD",
    "copyright": "versus3927",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png",
      "url.txt"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VERSUSCLOUD"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png",
      "category": "Audio"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.png",
      "category": "public.app-category.music"
    }
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  }
}
